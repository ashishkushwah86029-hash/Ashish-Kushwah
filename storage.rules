rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Room photos path: /room_photos/{ownerId}/{roomId}/{fileName}
    match /room_photos/{ownerId}/{roomId}/{fileName} {
      // Any user can read room photographs
      allow read: if true;
      // Only the verified room owner can upload photos for their own property
      // Enforce image type and max file size (10MB per photo)
      allow write: if request.auth != null &&
                      request.auth.uid == ownerId &&
                      request.resource.size < 10 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
      // Only the room owner can delete their room photo
      allow delete: if request.auth != null && request.auth.uid == ownerId;
    }
  }
}
